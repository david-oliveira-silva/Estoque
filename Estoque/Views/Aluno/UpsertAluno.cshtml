@using DOMAIN.Model
@model AlunoModel
@{
    ViewData["Title"] = (Model.AlunoNovo == true ? "Cadastrar Aluno" : "Editar Aluno" );
}
@if (TempData["Sucesso"] != null)
{
    <p class="alert alert-success">@TempData["Sucesso"]</p>
}
@if (TempData["Erro"] != null)
{
    <p class="alert alert-danger">@TempData["Erro"]</p>
}

<div class="Titulo d-flex justify-content-center">
    <h1>@(Model.AlunoNovo == true ? "Cadastrar Aluno" : "Editar Aluno")</h1>
</div>

<form asp-action=@(Model.AlunoNovo == true ? "CadastrarAluno" : "EditarAluno") asp-controller="Aluno" method="post">
        <input type="hidden" asp-for="Matricula" />
    <div class="form-group">
        <label asp-for="Matricula">Matricula</label>
        @if(Model.AlunoNovo == true)
        {
            <input asp-for="Matricula" class="form-control" placeholder="Digite o número da matrícula" />
        }
        else
        {
            <input asp-for="Matricula" class="form-control" disabled/>

        }
        <span asp-validation-for="Matricula" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" class="form-control" placeholder="Digite o seu nome" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CPF">CPF</label>
        <input asp-for="CPF" class="form-control" placeholder="Digite o seu CPF" onkeyup="formatarCPF(this)" maxlength="14" />
        <span asp-validation-for="CPF" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DataNascimento"></label>
        <input asp-for="DataNascimento" class="form-control" type="date" />
        <span asp-validation-for="DataNascimento" class="text-danger"></span>
    </div>
    <div id="sexo" class="mb-3 d-flex flex-column">
        <label asp-for="Sexo">Sexo</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Sexo" id="inlineRadio1" value="Masculino">
            <label class="form-check-label" asp-for="Sexo">Masculino</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Sexo" id="inlineRadio2" value="Feminino">
            <label class="form-check-label" asp-for="Sexo">Feminino</label>
        </div>
        <span asp-validation-for="Sexo" class="text-danger"></span>
    </div>

    <div id="Botoes" class="d-flex g-2 justify-content-center gap-2">
        <button type="submit" class="btn btn-primary fw-bold" style="width:250px">@(Model.AlunoNovo == true ? "Cadastrar" : "Editar")</button>
        <a asp-controller ="Aluno" asp-action = "ListarAluno" class="btn btn-success fw-bold" style="width:250px">Voltar</a>
    </div>

</form>

<script src="~/js/Aluno/Aluno.js"></script>
