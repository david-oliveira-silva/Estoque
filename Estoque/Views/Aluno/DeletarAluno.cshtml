@using DOMAIN.Model
@model AlunoModel
@{
    ViewData["Title"] = "Deletar Aluno";
}

@if (TempData["Erro"] != null)
{
    <p class="alert alert-danger">@TempData["Erro"]</p>
}

<div class="Titulo d-flex justify-content-center">
    <h1>Deletar Aluno</h1>
</div>

<form asp-action="DeletarAluno" asp-controller="Aluno" method="post">
    <input type="hidden" asp-for="Matricula" />
    <div class="form-group">
        <label asp-for="Matricula">Matricula</label>
            <input asp-for="Matricula" class="form-control" disabled />
        <span asp-validation-for="Matricula" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" class="form-control" disabled />
    </div>
    <div class="form-group">
        <label asp-for="CPF">CPF</label>
        <input asp-for="CPF" class="form-control" disabled/> 
    </div>
    <div class="form-group">
        <label asp-for="DataNascimento"></label>
        <input asp-for="DataNascimento" class="form-control" type="date" disabled/>
        <span asp-validation-for="DataNascimento" class="text-danger"></span>
    </div>
    <div id="sexo" class="mb-3 d-flex flex-column">
        <label asp-for="Sexo">Sexo</label>
        <input asp-for="Sexo" class="form-control" disabled />
    </div>

    <div id="Botoes" class="d-flex g-2 justify-content-center gap-2">
        <button type="submit" class="btn btn-danger fw-bold" style="width:250px">Deletar</button>
        <a asp-controller="Aluno" asp-action="ListarAluno" class="btn btn-success fw-bold" style="width:250px">Voltar</a>
    </div>

</form>
