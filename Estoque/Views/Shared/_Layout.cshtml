﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EM.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EM.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="d-flex">
        <header>
            <nav class="navbar navbar-expand-sm  d-flex flex-column" id="Nav-bar">
               
                <div class="container-fluid center justify-content-center">
                    
                    <div class="navbar-collapse collapse">
                        <ul class="navbar-nav flex-grow-1 d-flex flex-column">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Aluno" asp-action="ListarAluno">Aluno</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="" asp-action="">Produtos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Estoque" asp-action="ListarEstoque">Estoque</a>
                            </li>

                            
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <div class="d-flex flex-column flex-grow-1 min-vh-100">
        <div class="container" style="padding-top: 100px;">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                <p class="text-center">
                    &copy; 2025 - Projeto desenvolvido por David Oliveira. Acesse o código-fonte no
                    <a href="https://github.com/david-oliveira-silva/Estoque" target="_blank">
                        <i class="bi bi-github"></i> repositório no GitHub
                    </a>.
                </p>
            </div>
        </footer>
       
        </div>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>
</html>